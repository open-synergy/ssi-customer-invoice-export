<odoo>
<record id="customer_invoice_export_rule_ou" model="ir.rule">
    <field
            name="name"
        >customer_invoice_export - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_customer_invoice_export.model_customer_invoice_export"
        />
    <field name="groups" eval="[(4, ref('customer_invoice_export_ou_group'))]" />
    <field name="domain_force">
        ['|', ('operating_unit_id','=',False),
        ('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]
    </field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
